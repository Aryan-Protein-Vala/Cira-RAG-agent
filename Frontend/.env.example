# Frontend configuration (copy to .env.local)

# Where the Next.js server proxies /api/* to. The browser never calls this
# directly, so it may be a private address on the app server.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional: bypass the proxy and call the backend directly from the browser.
# Only set this if the backend is publicly reachable AND CIRA_ALLOWED_ORIGINS
# on the backend includes this app's origin.
# NEXT_PUBLIC_API_URL=https://cira-api.company.local
