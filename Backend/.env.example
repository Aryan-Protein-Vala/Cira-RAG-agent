# ─────────────────────────────────────────────────────────────────────────────
# CIRA backend configuration.  Copy to Backend/.env and fill in.
#   cp .env.example .env            (Windows: copy .env.example .env)
#
# SAFETY RULE: this file contains NO credentials and no internal hostnames.
# Anything you type here stays here — .env is git-ignored, and config.py
# refuses to ship a default for any of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Which data source to use ────────────────────────────────────────────────
#   auto      try every enabled source in CIRA_DATA_SOURCE_ORDER (HANA first)
#   hana      SAP HANA only — RECOMMENDED for production (full SQL depth)
#   service   SAP B1 Service Layer (OData) only
#   mssql     Microsoft SQL Server (B1 on MS SQL) only
#   simulator offline sandbox, always labelled SIMULATED
CIRA_DATA_SOURCE=hana
# Preference order for "auto". Remove a source from this list to ignore it.
CIRA_DATA_SOURCE_ORDER=hana,service,mssql,simulator

# ── SAP HANA (direct SQL — the primary path) ────────────────────────────────
HANA_HOST=
# 3<instance>13 is the system port of a tenant DB, 3<instance>15 the tenant SQL
# port; e.g. instance 00 -> 30013 / 30015. Use the tenant port if the company
# schema is not visible on the system port.
HANA_PORT=30013
# Use a READ-ONLY technical user with SELECT on the company schema only.
# Never SYSTEM, and never a user with SELECT on SYS catalog tables holding
# principals (SYS.USERS / SYS.DB_USERS contain password hashes).
HANA_USER=
HANA_PASSWORD=
# The SAP B1 company schema (same value as the Service Layer CompanyDB)
HANA_SCHEMA=
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERT=false
HANA_CONNECT_TIMEOUT_MS=8000
HANA_POOL_SIZE=4
# Extra schemas the raw-SQL tool may read (comma separated). Everything outside
# the company schema + this list is refused by the SQL guard.
HANA_EXTRA_SCHEMAS=

# ── Microsoft SQL Server (only if B1 runs on MS SQL) ─────────────────────────
# Leave MSSQL_HOST empty and this source is not even considered.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=
MSSQL_SCHEMA=dbo
MSSQL_CONNECT_TIMEOUT=8000
MSSQL_QUERY_TIMEOUT=120
MSSQL_POOL_SIZE=4

# ── SAP Business One Service Layer (OData; also required for writes) ────────
SAP_B1_HOST=
SAP_B1_PORT=50000
SAP_B1_USER=
SAP_B1_PASSWORD=
SAP_B1_COMPANY_DB=
SAP_B1_VERIFY_SSL=false
SAP_B1_TIMEOUT_S=20

# ── Multi-tenancy (optional) ─────────────────────────────────────────────────
# Company DBs users may sign in to. Per-tenant overrides: CIRA_TENANT_<NAME>_<SETTING>
#   CIRA_TENANTS=ACME_PROD,ACME_TEST
#   CIRA_TENANT_ACME_TEST_MSSQL_HOST=db.internal
#   CIRA_TENANT_ACME_TEST_MSSQL_USER=cira_ro
CIRA_TENANTS=

# ── LLM (OpenRouter, or any OpenAI-compatible endpoint) ───────────────────────
# Without a key CIRA still runs: it falls back to a deterministic planner that
# queries SAP and renders tables/charts, just without free-form reasoning.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CIRA_MODEL=openrouter/free
CIRA_LLM_TEMPERATURE=0.1
# Optional: speech-to-text for the microphone button (Groq Whisper).
GROQ_API_KEY=

# ── Row limits ───────────────────────────────────────────────────────────────
CIRA_DEFAULT_ROW_LIMIT=500
CIRA_MAX_ROW_LIMIT=10000
CIRA_MAX_PERSISTED_ROWS=2000
CIRA_MAX_STREAMED_ROWS=2000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session tokens. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
CIRA_SECRET_KEY=
CIRA_TOKEN_TTL_SECONDS=43200
# Bootstrap admin. With either value empty there is NO admin account at all.
# Replace this with your IdP / SAP OUSR lookup as soon as you can.
CIRA_ADMIN_ID=
CIRA_ADMIN_PASSWORD=
# Demo mode: any employee ID + any password signs in. Keep this FALSE.
CIRA_ALLOW_ANY_EMPLOYEE=false

# ── SAP writes (data-entry forms creating records in the ERP) ────────────────
# Off by default. When on: admin roles only, entities allowlisted, audited.
CIRA_SAP_WRITE_ENABLED=false
CIRA_SAP_WRITE_ROLES=admin
CIRA_SAP_WRITE_ENTITIES=BusinessPartners,Items,Orders,Invoices,Quotations,PurchaseOrders,JournalEntries

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Required in production. Comma separated, e.g. http://localhost:3000,https://cira.company.local
# With CIRA_STRICT=true (default) an empty list here is a startup error.
CIRA_ALLOWED_ORIGINS=
CIRA_ALLOWED_ORIGIN_REGEX=
CIRA_STRICT=true
# The offline sandbox. Set false in production so a dead HANA connection can
# never be mistaken for a working one (queries then fail loudly instead).
CIRA_ALLOW_SIMULATOR=true

# ── Audit trail ──────────────────────────────────────────────────────────────
CIRA_AUDIT_ENABLED=true
CIRA_LOG_LEVEL=INFO
