# ─────────────────────────────────────────────────────────────────────────────
# CIRA backend configuration.  Copy to Backend/.env and fill in.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Which data source to use ────────────────────────────────────────────────
#   auto      HANA -> Service Layer -> offline simulator (recommended)
#   hana      only direct HANA SQL
#   service   only the SAP B1 Service Layer (OData)
#   simulator offline sandbox with generated SAP B1 data (no ERP needed)
CIRA_DATA_SOURCE=auto

# ── SAP HANA (direct SQL — full depth: any table, view, join, aggregate) ────
HANA_HOST=
# 30013 = SYSTEMDB / system port of instance 00.
# If a query says the schema is missing, try the TENANT port 3<instance>15 (30015).
HANA_PORT=30013
HANA_USER=SYSTEM
HANA_PASSWORD=
# The SAP B1 company schema (same value as the Service Layer CompanyDB)
HANA_SCHEMA=
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERT=false
HANA_CONNECT_TIMEOUT_MS=8000
HANA_POOL_SIZE=4

# ── Microsoft SQL Server (Alternative to HANA) ──────────────────────────────
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=
MSSQL_CONNECT_TIMEOUT=8000
MSSQL_POOL_SIZE=4

# ── SAP Business One Service Layer (OData) ──────────────────────────────────
SAP_B1_HOST=
SAP_B1_PORT=50000
# SERVICE_LAYER_PORT is explicitly for the SL OData endpoint (always 50000).
# SAP_B1_PORT may be used for HANA (30013) — they must not collide.
SERVICE_LAYER_PORT=50000
SAP_B1_COMPANY_DB=
SAP_B1_USER=manager
SAP_B1_PASSWORD=
SAP_B1_VERIFY_SSL=false

# ── LLM (OpenRouter, or any OpenAI-compatible endpoint) ─────────────────────
# Without a key CIRA still runs: it falls back to a deterministic planner that
# queries SAP and renders tables/charts, just without free-form reasoning.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CIRA_MODEL=openrouter/free
CIRA_LLM_TEMPERATURE=0.1

# ── Groq API Key (For Voice/Whisper Transcriptions) ─────────────────────────
# We use Groq's insanely fast Whisper model for processing voice memos.
GROQ_API_KEY=

# ── Row limits ───────────────────────────────────────────────────────────────
CIRA_DEFAULT_ROW_LIMIT=500
CIRA_MAX_ROW_LIMIT=10000
CIRA_MAX_PERSISTED_ROWS=2000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session tokens. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
CIRA_SECRET_KEY=
CIRA_TOKEN_TTL_SECONDS=43200
CIRA_ADMIN_ID=admin
# IMPORTANT: Change this before any deployment!
CIRA_ADMIN_PASSWORD=
# Demo mode: any employee ID + any password signs in. Set false in production.
CIRA_ALLOW_ANY_EMPLOYEE=false

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma separated list, e.g. http://localhost:3000,https://cira.company.local
# Leave empty to allow any origin (development only).
CIRA_ALLOWED_ORIGINS=
CIRA_LOG_LEVEL=INFO
