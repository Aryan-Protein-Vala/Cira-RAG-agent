# ─────────────────────────────────────────────────────────────────────────────
# CIRA backend configuration.  Copy to Backend/.env and fill in.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Which data source to use ────────────────────────────────────────────────
#   auto      HANA -> Service Layer -> offline simulator (recommended)
#   hana      only direct HANA SQL
#   service   only the SAP B1 Service Layer (OData)
#   simulator offline sandbox with generated SAP B1 data (no ERP needed)
CIRA_DATA_SOURCE=auto

# ── SAP HANA (direct SQL — full depth: any table, view, join, aggregate) ────
HANA_HOST=20.204.5.237
# Single-container tenant DBs are usually 3<instance>15 (e.g. 30015);
# 30013 is the SYSTEMDB/system port on instance 00.
HANA_PORT=30015
HANA_USER=SYSTEM
HANA_PASSWORD=
# The SAP B1 company schema (same value as the Service Layer CompanyDB)
HANA_SCHEMA=CIRA_DEMO_NEW
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERT=false
HANA_CONNECT_TIMEOUT_MS=8000
HANA_POOL_SIZE=4

# ── SAP Business One Service Layer (OData fallback) ─────────────────────────
SAP_B1_HOST=20.204.5.237
SAP_B1_PORT=50000
SAP_B1_COMPANY_DB=CIRA_DEMO_NEW
SAP_B1_USER=manager
SAP_B1_PASSWORD=
SAP_B1_VERIFY_SSL=false

# ── LLM (OpenRouter, or any OpenAI-compatible endpoint) ─────────────────────
# Without a key CIRA still runs: it falls back to a deterministic planner that
# queries SAP and renders tables/charts, just without free-form reasoning.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CIRA_MODEL=anthropic/claude-3.5-sonnet
CIRA_LLM_TEMPERATURE=0.1

# ── Row limits ───────────────────────────────────────────────────────────────
CIRA_DEFAULT_ROW_LIMIT=500
CIRA_MAX_ROW_LIMIT=10000
CIRA_MAX_PERSISTED_ROWS=2000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session tokens. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
CIRA_SECRET_KEY=
CIRA_TOKEN_TTL_SECONDS=43200
CIRA_ADMIN_ID=admin
CIRA_ADMIN_PASSWORD=asdfghjkl;
# Demo mode: any employee ID + any password signs in. Set false once SSO is wired up.
CIRA_ALLOW_ANY_EMPLOYEE=true

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma separated list, e.g. http://localhost:3000,https://cira.company.local
# Leave empty to allow any origin (development only).
CIRA_ALLOWED_ORIGINS=
CIRA_LOG_LEVEL=INFO
